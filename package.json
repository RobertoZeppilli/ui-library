{
  "name": "trama",
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=24"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./styles.css": "./styles.css",
    "./themes/*.css": "./themes/*.css"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RobertoZeppilli/ui-library.git"
  },
  "files": [
    "CHANGELOG.md",
    "dist",
    "styles.css",
    "themes"
  ],
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc",
    "build": "tsdown && node scripts/agent-docs.ts",
    "build:docs": "node scripts/agent-docs.ts",
    "prepack": "pnpm build",
    "changeset": "changeset",
    "lint:workflows": "actionlint .github/workflows/release.yml",
    "pack:check": "pnpm pack --dry-run",
    "build:example": "pnpm build && pnpm --filter trama-example-next build"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19",
    "tailwindcss": "^4"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.1"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@kjanat/actionlint": "^1.17.1",
    "@storybook/addon-a11y": "^10.6.8",
    "@storybook/addon-themes": "^10.6.8",
    "@storybook/addon-vitest": "^10.6.8",
    "@storybook/react-vite": "^10.6.8",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@vitest/browser-playwright": "^5.1.1",
    "playwright": "^1.65.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.8",
    "tailwindcss": "^4.3.5",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
